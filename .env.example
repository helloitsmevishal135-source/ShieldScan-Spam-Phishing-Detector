# Flask (use FLASK_ENV=production when deploying with HTTPS)
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# Optional: dedicated key for encrypting Gmail tokens (defaults to SECRET_KEY if empty)
# TOKEN_ENCRYPTION_KEY=replace-with-another-long-random-string

# Local dev only — required for http://127.0.0.1 Gmail OAuth (never set in production)
OAUTHLIB_INSECURE_TRANSPORT=1

# Optional database URI (defaults to sqlite:///instance/shield.db)
# DATABASE_URL=sqlite:///instance/shield.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Google Cloud OAuth2 (Gmail API — readonly)
# Create credentials: https://console.cloud.google.com/apis/credentials
# Enable Gmail API for your project
# Authorized redirect URI must match exactly:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/gmail/callback

# Gmail sync (minutes between background fetches; 0 = disabled)
GMAIL_SYNC_INTERVAL_MINUTES=5
GMAIL_FETCH_MAX_RESULTS=25

# Admin panel (default account created on first startup if none exists)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Website crawler
CRAWLER_TIMEOUT_SECONDS=12
CRAWLER_MAX_LINKS=50
CRAWLER_MAX_BYTES=2000000
